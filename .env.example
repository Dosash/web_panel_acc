# Пароль для входа в веб-панель. Пусто — вход без пароля (только для локального использования!)
PANEL_PASSWORD=

# Адрес и порт. 127.0.0.1 — панель доступна только с этого компьютера.
HOST=127.0.0.1
PORT=8080

# Веб-панель из локальной сети: кнопка первой в рейке, открывается внутри TG Panel.
# Пустой адрес — кнопки нет. Пример: LAN_PANEL_URL=http://192.168.3.18/
LAN_PANEL_URL=
LAN_PANEL_NAME=
# Порт прокси для встраивания (сайт может запрещать iframe). 0 — открывать в новой вкладке.
LAN_PANEL_PROXY_PORT=8081

# Папка с базой, ключом шифрования и кэшем
DATA_DIR=data
