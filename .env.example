# ───────── Веб-панель ─────────
# 127.0.0.1 — панель доступна только с этого компьютера/сервера (открывать через SSH-туннель или nginx);
# 0.0.0.0 — доступна из сети (только вместе с паролем!).
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Пароль входа в панель. Пусто — вход без пароля (только для локального использования!)
WEB_PASSWORD=

# Путь панели, если она открыта не в корне сайта (например, /accounts → http://сервер/accounts/). Пусто — в корне.
WEB_PREFIX=

# Ссылка «Все панели» в левой колонке (если у вас несколько панелей за одним nginx), например /. Пусто — без ссылки.
HUB_URL=

# ───────── Хранение ─────────
# Папка с базой, ключом шифрования сессий и кэшем. В Docker — /app/data (папка data/ — том).
DATA_DIR=data
